# Production environment — the split deployment.
#
# Nothing here is read by docker compose. These are the values you paste into
# the two dashboards: the API block into Railway, the web block into Vercel.
# Keep this file free of real secrets; it is a checklist, not a vault.

# ─────────────────────────────────────────────────────────────────────────────
# API service (Railway) — deployed from ./backend via its Dockerfile
# ─────────────────────────────────────────────────────────────────────────────

# Railway injects these when you attach the Postgres and Meilisearch services.
# Reference them rather than pasting literals, so they survive a service move:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# Note the driver: SQLAlchemy needs postgresql+asyncpg://, while Railway hands
# out postgresql://. Rewrite the scheme or the app will not start.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/railway

MEILI_URL=http://meilisearch.railway.internal:7700
MEILI_MASTER_KEY=generate-a-long-random-string

# The port is injected by the platform; the Dockerfile already honours it.
# PORT=

# Schema and corpus are created on first boot: the app enables pgvector and
# pg_trgm, creates the tables, seeds all 59 curated cards and indexes them.
# Leave this on for the first deploy, then decide whether to keep it.
AUTO_SEED=true

# Off in production, always. These endpoints reseed, ingest and reindex, and
# they are unauthenticated. The CLI does the same jobs over `railway run`.
ADMIN_API_ENABLED=false

# Optional. Without a key the platform runs on curated content, keyword search
# and the pre-built graph — everything except semantic search, re-explanation,
# discovery and card writing.
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Scheduled ingestion. Leave false until you have watched a manual run.
INGESTION_ENABLED=false
INGESTION_MAX_NEW_CARDS=5

# Reddit collection. Without credentials the Atom-feed fallback is used, which
# is heavily throttled from datacentre addresses — worth setting in production.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=curio/1.0 (collective-curiosity)

# Push notifications. Generate with: python -m app.cli vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Not needed for the browser, which reaches the API same-origin through the
# Next rewrite. Set it only if something calls the API cross-origin directly.
CORS_ORIGINS=

# Telegram bot and Mini App. Both URLs are the *frontend's* public origin —
# the Next rewrite proxies /api through to this API, so Telegram reaches the
# webhook at <frontend>/api/v1/telegram/webhook and never needs the API's own
# hostname. No tunnel in production; these are real domains.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBAPP_URL=https://your-app.vercel.app
TELEGRAM_PUBLIC_URL=https://your-app.vercel.app
# Generate once and keep it: rotating it means re-running `app.cli telegram
# setup`, since Telegram stores the secret alongside the webhook URL.
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Web (Vercel) — deployed from ./frontend
# ─────────────────────────────────────────────────────────────────────────────

# Where the Next server proxies /api/* to. Must be the public Railway URL,
# with no trailing slash. This is what keeps the API same-origin in the
# browser, which the service worker and push subscription both depend on.
API_URL=https://your-api.up.railway.app

# Must match VAPID_PUBLIC_KEY above. It is compiled into the client bundle,
# so changing it requires a redeploy, not just a restart.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
