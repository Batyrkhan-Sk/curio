# ---------------------------------------------------------------------------
# Curio — Collective Curiosity
# Copy to `.env` and fill in what you have. Every value here has a working
# default except the Gemini key: without it the AI pipeline is simply disabled
# and the platform serves curated + already-synthesised content.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=curio
POSTGRES_PASSWORD=curio
POSTGRES_DB=curio
POSTGRES_PORT=5433

# --- Search ---------------------------------------------------------------
MEILI_MASTER_KEY=curio_dev_master_key
MEILI_PORT=7700

# --- Services -------------------------------------------------------------
API_PORT=8000
WEB_PORT=3001
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# --- AI -------------------------------------------------------------------
# Leave GEMINI_API_KEY empty to run entirely without an LLM. Synthesis,
# embeddings, and "explain it differently" become unavailable; everything
# else (browsing, search, graph, saves, notifications) still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Quota is counted per model, so the client rotates through this pool as each
# one is exhausted. Comma-separated, best first.
# GEMINI_MODEL_POOL=gemini-3.6-flash,gemini-3.5-flash,gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Fallback providers ----------------------------------------------------
# Used automatically when Gemini is out of quota or failing.
#
# Groq (api.groq.com) is an inference provider running open models — keys start
# with `gsk_`. Grok is xAI's model, configured separately below. They are
# different companies with confusingly similar names; putting a Groq key in the
# xAI slot gets it rejected.
#
# Neither offers embeddings, so semantic search still requires GEMINI_API_KEY.
# Run `docker compose run --rm api python -m app.cli providers` to probe them
# and list the model ids your keys can actually use.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL_POOL=openai/gpt-oss-120b,llama-3.3-70b-versatile,qwen/qwen3.6-27b

XAI_API_KEY=
XAI_MODEL=grok-4-fast

LLM_PROVIDER_ORDER=gemini,groq,xai

# --- Ingestion ------------------------------------------------------------
# When true the scheduler polls public sources for recurring questions.
INGESTION_ENABLED=false
INGESTION_INTERVAL_MINUTES=180
# Reddit. Without credentials the collector falls back to the public Atom feed,
# which Reddit throttles hard — expect a fraction of the questions and no
# scores. With them it uses the authenticated API: 100 requests/minute, scores
# and comment counts included.
# Create a "script" app at https://www.reddit.com/prefs/apps to get both values:
# the client id sits under the app name, the secret is labelled "secret".
REDDIT_USER_AGENT=curio/0.1 (collective-curiosity)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Content --------------------------------------------------------------
AUTO_SEED=true

# Unauthenticated reseed/ingest/reindex endpoints. Fine on localhost; set false
# before exposing the API through a tunnel or to your LAN. The CLI still works.
ADMIN_API_ENABLED=true

# --- Telegram ---------------------------------------------------------------
# Optional. Empty leaves the bot and the Mini App switched off; nothing else in
# the platform changes.
#
#   1. @BotFather -> /newbot -> paste the token below, and the @name too
#   2. Start a tunnel:  cloudflared tunnel --url http://localhost:3001
#   3. Put that https URL in both URL settings below
#   4. docker compose run --rm api python -m app.cli telegram setup
#
# For inline mode (typing "@yourbot wifi" in any chat) also send BotFather
# /setinline. Everything else is applied by the command above.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Where the *frontend* is publicly reachable. Telegram refuses to open a Mini
# App over http or from an IP, so in development this is the tunnel, not
# localhost. Leave empty and the chat bot still works — only the reader button
# disappears.
TELEGRAM_WEBAPP_URL=

# Where this *API* is publicly reachable, i.e. where Telegram posts updates.
# Normally the same tunnel: the frontend proxies /api through to the API.
TELEGRAM_PUBLIC_URL=

# Written by `app.cli telegram setup` if you leave it empty. Telegram sends it
# back on every webhook call, and the webhook rejects anything without it — the
# URL is public, so this is the only thing making the caller Telegram.
TELEGRAM_WEBHOOK_SECRET=

# --- Web Push -------------------------------------------------------------
# Generate a pair with:  docker compose run --rm api python -m app.cli vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:curiosity@example.com

# --- Single-VM deployment --------------------------------------------------
# Only read by docker-compose.prod.yml; ignored in development. See
# docs/DEPLOY-ORACLE.md for the whole procedure.
#
# The stack needs one public entrypoint, and there are two, chosen with
# --profile. Fill in whichever you picked; the other can stay empty.
#
# Both give the bot a *stable* https hostname. That is the whole point: a
# `cloudflared tunnel --url` quick tunnel gets a new random URL every restart,
# and the Telegram webhook silently points at the dead one.

# --profile tailscale — free, no domain needed. Tailscale owns ts.net and
# issues the certificate. Generate a key at
# https://login.tailscale.com/admin/settings/keys — make it *reusable* and
# *non-ephemeral*, or the node is dropped on restart and comes back under a
# different name, which breaks the webhook.
TAILSCALE_AUTHKEY=
# Machine name, and therefore the public host:
#   https://<TAILSCALE_HOSTNAME>.<your-tailnet>.ts.net
TAILSCALE_HOSTNAME=curio

# --profile cloudflare — needs a domain you own, in Cloudflare. Token comes
# from Zero Trust -> Networks -> Tunnels. Route its public hostname to
# `web:3000`, the compose service name, not localhost.
CLOUDFLARE_TUNNEL_TOKEN=
